{
	"name": "eumenes-pipeline",
	"version": "0.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"packageManager": "bun@1.4.4",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "bun check && bun check -p tsconfig.build.json",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --deny-warnings --fix",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"test": "bun test",
		"check:all": "bun run typecheck && bun run lint && bun run format:check && bun test",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"pack:check": "bun scripts/pack.ts --dry-run",
		"pack": "bun scripts/pack.ts",
		"contracts:extract": "bun scripts/extract-eumenes-contracts.ts",
		"bench:catalog": "bun bench/cli/catalog.ts",
		"bench:verify": "bun bench/cli/verify.ts",
		"bench:format": "bun bench/cli/format.ts",
		"bench:selection": "bun bench/cli/selection.ts",
		"bench:selection-exp": "bun bench/cli/selection-experiment.ts",
		"bench:selection-tuning": "bun bench/cli/selection-tuning.ts",
		"bench:export": "bun bench/cli/export.ts"
	},
	"dependencies": {
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"eumenes_router": "file:vendor/router/eumenes_router-0.0.1-3329927c411b.tgz",
		"jsonrepair": "^3.15.0",
		"oxlint": "1.86.0",
		"typescript": "7.0.2",
		"yaml": "2.9.1"
	}
}
